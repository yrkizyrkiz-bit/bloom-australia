# Copy to .env and fill in values (never commit .env)

# Prefer a pooled Postgres URL in production (Neon/Supabase pooler).
# On Netlify, prisma also appends connection_limit=1 per serverless isolate.
# Optional: set DIRECT_URL to the non-pooled URL for migrations only.
DATABASE_URL=
# DIRECT_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_DEV_MODE=true

# TEMPORARY: 6-digit code that verifies email or mobile during development.
# Unset this (and remove src/lib/auth/dev-verification.ts) when finishing development.
DEV_VERIFICATION_CODE=000000

# Calendar (Cal.com)
NEXT_PUBLIC_CALCOM_USERNAME=
NEXT_PUBLIC_CALCOM_EVENT_SLUG=
CALCOM_WEBHOOK_SECRET=

# AI (optional)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cron (required in production — Vercel cron / external schedulers)
CRON_SECRET=

# Australian address lookup (optional, server-side). Enables Google Places autocomplete
# during membership signup. Without it, lookup still works via a public AU geocoder.
GOOGLE_PLACES_API_KEY=

# Rate limiting uses DB-backed limits on auth/checkout API routes (RateLimitBucket table).

# Portal renewal gate: when billing is missing/unknown, allow access for legacy migrated members.
# Default: false in production, true in development.
RENEWAL_GATE_LEGACY_FAIL_OPEN=false
