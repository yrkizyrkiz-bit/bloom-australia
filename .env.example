# Copy to .env and fill in values (never commit .env)

# Prefer a pooled Postgres URL in production (Neon/Supabase pooler).
# On Netlify, prisma also appends connection_limit=1 per serverless isolate.
# Optional: set DIRECT_URL to the non-pooled URL for migrations only.
DATABASE_URL=
# DIRECT_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
# google_workspace uses Gmail SMTP relay. resend is the fallback until Workspace
# is proven. Rollback: set EMAIL_PROVIDER=resend and keep RESEND_API_KEY.
EMAIL_PROVIDER=resend
# Proven test From: info@sanative.com.au. Production can use noreply@ later.
EMAIL_FROM=info@sanative.com.au
EMAIL_FROM_NAME=Sanative Health
# Google Workspace SMTP (App Password, never store in the database)
GOOGLE_SMTP_USER=info@sanative.com.au
GOOGLE_SMTP_PASS=
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
# Keep until Workspace cutover is confirmed, then remove Resend.
RESEND_API_KEY=
# LOCAL ONLY. Set to "true" to log verification codes to the console instead of
# sending them. Ignored when NODE_ENV=production. Never set this on Netlify.
EMAIL_DEV_MODE=

# SMS (Cellcast) — used for phone verification + admin CRM/notifications only
SMS_PROVIDER=cellcast
CELLCAST_API_KEY=
CELLCAST_SENDER_ID=Sanative


# TESTING ONLY. Optional 6-digit code that verifies any email or mobile
# (e.g. 000000) so signup can be tested without inbox delivery. Unset before go-live.
DEV_VERIFICATION_CODE=

# Calendar (Cal.com)
NEXT_PUBLIC_CALCOM_USERNAME=
NEXT_PUBLIC_CALCOM_EVENT_SLUG=
CALCOM_WEBHOOK_SECRET=

# AI (optional)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cron (required in production — Vercel cron / external schedulers)
CRON_SECRET=

# Australian address lookup (optional, server-side). Enables Google Places autocomplete
# during membership signup. Without it, lookup still works via a public AU geocoder.
GOOGLE_PLACES_API_KEY=

# Rate limiting uses DB-backed limits on auth/checkout API routes (RateLimitBucket table).

# Portal renewal gate: when billing is missing/unknown, allow access for legacy migrated members.
# Default: false in production, true in development.
RENEWAL_GATE_LEGACY_FAIL_OPEN=false

# Web Push (care partner / admin Live Chat alerts on iOS PWA + Android Chrome).
# Generate once: npx web-push generate-vapid-keys
# VAPID_SUBJECT should be a mailto: or https: contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sanative.com.au
